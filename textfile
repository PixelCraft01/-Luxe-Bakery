/* ---------- Navbar ---------- */
.navbar {
    height: 85px;
    padding: 0;
    z-index: 1050;
    background: transparent !important;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.navbar .container {
    height: 100%;
}

.navbar.scrolled {
    height: 72px;
    background: rgba(255, 248, 242, 0.92) !important;
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    box-shadow: 0 1px 0 rgba(44, 36, 29, 0.06), 0 4px 20px rgba(44, 36, 29, 0.04);
}

[data-theme="dark"] .navbar.scrolled {
    background: rgba(26, 21, 18, 0.92) !important;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.04), 0 4px 20px rgba(0, 0, 0, 0.2);
}

/* Logo */
.navbar-brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
}

.navbar-brand img {
    height: 58px;
    width: auto;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    object-fit: contain;
}

.navbar.scrolled .navbar-brand img {
    height: 36px;
}

/* Center Navigation */
.navbar-center {
    flex: 1;
    justify-content: center;
}

.navbar-nav {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
}

.nav-item {
    position: relative;
}

.nav-link {
    font-size: 0.88rem;
    font-weight: 500;
    letter-spacing: 0.3px;
    padding: 8px 18px !important;
    position: relative;
    color: var(--dark) !important;
    border-radius: 8px;
    transition: all 0.3s ease;
    white-space: nowrap;
}

.nav-link::after {
    content: '';
    position: absolute;
    bottom: 2px;
    left: 50%;
    width: 0;
    height: 2px;
    background: var(--primary);
    border-radius: 2px;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    transform: translateX(-50%);
}

.nav-link:hover::after,
.nav-link.active::after {
    width: 24px;
}

.nav-link:hover {
    color: var(--primary) !important;
    background: rgba(200, 155, 60, 0.06);
}

.nav-link.active {
    color: var(--primary) !important;
    font-weight: 600;
}

/* Right Actions */
.navbar-right {
    gap: 6px;
    flex-shrink: 0;
}

.nav-icon-btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    font-size: 1.05rem;
    color: var(--dark);
}

.nav-icon-btn:hover {
    background: rgba(200, 155, 60, 0.1);
    color: var(--primary);
    transform: scale(1.05);
}

.nav-counter {
    position: absolute;
    top: 0;
    right: 0;
    min-width: 17px;
    height: 17px;
    background: var(--primary);
    color: var(--white);
    border-radius: 50%;
    font-size: 0.6rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    padding: 0 4px;
    border: 2px solid var(--cream);
    transition: var(--transition);
}

.navbar.scrolled .nav-counter {
    border-color: rgba(255, 248, 242, 0.92);
}

/* Theme Toggle */
.theme-toggle .bi-sun-fill,
.theme-toggle .bi-moon-fill {
    transition: var(--transition);
}

[data-theme="dark"] .theme-toggle .bi-sun-fill {
    display: inline;
}

[data-theme="dark"] .theme-toggle .bi-moon-fill {
    display: none;
}

[data-theme="light"] .theme-toggle .bi-sun-fill,
:not([data-theme]) .theme-toggle .bi-sun-fill {
    display: none;
}

:not([data-theme]) .theme-toggle .bi-moon-fill {
    display: inline;
}

/* Navbar Toggler (mobile) */
.navbar-toggler {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: none !important;
    background: transparent;
    color: var(--dark);
    font-size: 1.3rem;
    transition: var(--transition);
}

.navbar-toggler:hover {
    background: rgba(200, 155, 60, 0.1);
    color: var(--primary);
}

/* Offcanvas Mobile */
.offcanvas {
    max-width: 340px;
    border: none;
}

.offcanvas-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    border-bottom: 1px solid var(--gray);
}

.offcanvas-logo {
    height: 40px;
    width: auto;
}

.offcanvas-body {
    padding: 24px;
}

.offcanvas-body .nav-link {
    font-size: 1.05rem;
    padding: 12px 16px !important;
    border-radius: 10px;
    font-weight: 500;
}

.offcanvas-body .nav-link:hover {
    background: rgba(200, 155, 60, 0.08);
}




















